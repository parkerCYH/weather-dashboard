generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Country {
  id     Int    @id @default(autoincrement())
  code   String @unique
  name   String
  cities City[]

  @@map("countries")
}

model City {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  name        String
  countryId   Int
  country     Country      @relation(fields: [countryId], references: [id], onDelete: Cascade)
  coordinates Coordinates?

  @@map("cities")
}

model Coordinates {
  id        Int   @id @default(autoincrement())
  cityId    Int   @unique
  latitude  Float
  longitude Float
  city      City  @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@map("coordinates")
}
